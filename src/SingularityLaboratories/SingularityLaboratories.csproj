<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.SingularityLaboratories</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>TheSingularityWorkshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Portable laboratory definitions, experiment configuration, execution records, and scientific provenance contracts.</Description>
    <PackageTags>laboratory;experiments;science;research;education;microbundle</PackageTags>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.SingularityLaboratories</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
